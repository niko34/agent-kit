{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /Users/*)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf /Library/*)",
      "Bash(rm -rf /System/*)",
      "Bash(rm -rf /Applications/*)",
      "Bash(rm -rf /etc/*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout --*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(glab mr create*)",
      "Bash(glab mr merge*)",
      "Bash(glab release create*)",
      "Bash(glab release delete*)",
      "Bash(npm install*)",
      "Bash(npm publish*)",
      "Bash(pnpm add*)",
      "Bash(yarn add*)",
      "Bash(pip install*)",
      "Bash(docker compose down*)",
      "Bash(rm -rf ../*)",
      "Bash(rm -rf /opt/*)",
      "Bash(rm -rf /usr/*)"
    ],
    "allow": [
      "Task",
      "TodoWrite",

      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx vitest*)",
      "Bash(npx eslint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm run *)",
      "Bash(yarn test*)",
      "Bash(pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(python3 tools/sync_copilot_agents.py *)",
      "Bash(node --check *)",
      "Bash(./tools/*)",
      "Bash(./scripts/*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git tag*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git mv*)",
      "Bash(git ls-files*)",
      "Bash(git rev-list*)",
      "Bash(git rev-parse*)",
      "Bash(git check-ignore*)",
      "Bash(git show-ref*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh auth status*)",
      "Bash(glab release list*)",
      "Bash(glab release view*)",
      "Bash(glab mr view*)",
      "Bash(glab mr list*)",
      "Bash(glab ci status*)",
      "Bash(glab auth status*)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(diff *)",
      "Bash(du *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(test *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(tr *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(xargs *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(unzip -l*)",
      "Bash(zip *)"
    ]
  }
}
